generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
}

enum Role {
  USER
  ADMIN
}

model Produto {
    id Int @id @default(autoincrement())
    nome String
    descricao String
    preco Decimal
    quantidade Int
    updatedAt DateTime @updatedAt
}